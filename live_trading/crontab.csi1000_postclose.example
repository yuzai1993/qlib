# Legacy template only. macOS production uses the user LaunchAgent in README.md.
# Do not install alongside launchd: cron cannot reliably access the SMB keychain ACL.
# Secrets/account IDs belong in ~/.qlib_live_env, never in this file.

SHELL=/bin/bash
PATH=/opt/anaconda3/envs/qlib/bin:/usr/local/bin:/usr/bin:/bin

# One 22:30 trigger runs postclose -> publish -> evening serially and records
# one atomic attempt receipt per stage. Failed stages remain manual recovery.
30 22 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_scheduler_cron.sh alla_v4_ladder_k1h5_postclose_real
