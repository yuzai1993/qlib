# Install only after the REAL one-lot prerequisites in README.md pass.
# Secrets/account IDs belong in ~/.qlib_live_env, never in this file.

SHELL=/bin/bash
PATH=/opt/anaconda3/envs/qlib/bin:/usr/local/bin:/usr/bin:/bin

# One 16:00 trigger runs postclose -> publish -> evening serially and records
# one atomic attempt receipt per stage. Failed stages remain manual recovery.
0 16 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_scheduler_cron.sh csi1000_b6m_b2s_postclose_real
