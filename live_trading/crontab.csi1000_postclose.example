# EXAMPLE ONLY. Do not install until the shadow prerequisites in README.md pass.
# Secrets/account IDs belong in ~/.qlib_live_env, never in this file.

SHELL=/bin/bash
PATH=/opt/anaconda3/envs/qlib/bin:/usr/local/bin:/usr/bin:/bin

# Import QMT receipts, then reconcile the durable zero/nonzero order batch.
32 15 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_import_cron.sh csi1000_b6m_b2s_postclose && /Users/yuxianqi/Project/qlib/live_trading/run_monitor_cron.sh postmarket csi1000_b6m_b2s_postclose

# Requires the daily Qlib provider update to have completed first.
35 15 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_monitor_cron.sh report csi1000_b6m_b2s_postclose

# Publish T+1 from the latest T close data. LIVE_RUN_MODE defaults to SIMULATE.
0 21 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_publish_cron.sh csi1000_b6m_b2s_postclose
5 22 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_publish_catchup_cron.sh csi1000_b6m_b2s_postclose
15 22 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_monitor_cron.sh evening csi1000_b6m_b2s_postclose
