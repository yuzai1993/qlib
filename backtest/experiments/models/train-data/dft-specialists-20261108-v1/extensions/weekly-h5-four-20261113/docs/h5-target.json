  "source_code": "\"\"\"Replay v5 H20 twice (old rank and updated quote source), then build causal-split H5 quantile10-old.\"\"\"\nimport gc\nimport gzip\nimport hashlib\nimport json\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\"/Users/yuxianqi/Project/qlib\")\nPARENT = ROOT / \"backtest/experiments/models/train-data/dft-specialists-20261108-v1/extensions\"\nOUT = PARENT / \"weekly-h5-four-20261113\"\nWEEK = PARENT / \"forward-spread-20261112/stages/weekly-h5/data/date-labels.csv\"\nGRADING = ROOT / \"backtest/experiments/models/training-target/label-grading-p50-20261106-v1\"\nUPDATED = ROOT / \"backtest/experiments/models/training-target/horizon-style-p50-20261105-v1\"\nCACHE = ROOT / \"backtest/datasets/regime-adapt-cache/shared-v1\"\nPROVIDER = ROOT / \"backtest/result/20261103_h20_causal_inputs/evaluation-provider\"\nDATES = ROOT / \"backtest/configs/regime-adapt/train_dates_v1.csv\"\nWEIGHTS = ROOT / \"backtest/configs/regime-adapt/day_weights_m0_v1.csv\"\nBOUNDARY = pd.Timestamp(\"2020-07-31\")\nsys.path.insert(0,str(ROOT))\nfrom backtest.scripts.prepare.prepare_regime_train_chunks import cache_value_summary\n\n\ndef load(p):\n    return json.loads(p.read_text())\n\n\ndef fp(p, expected=None):\n    with p.open(\"rb\") as stream:\n        sha = hashlib.file_digest(stream, \"sha256\").hexdigest()\n    rec = {\"path\": str(p.relative_to(ROOT)), \"sha256\": sha, \"size\": p.stat().st_size}\n    if expected:\n        assert sha == expected[\"sha256\"] and rec[\"size\"] == expected[\"size\"], p\n    return rec\n\n\ndef cache_manifest(kind, h):\n    for p in (CACHE / kind).glob(\"*/manifest.json\"):\n        m = load(p)\n        if m[\"spec\"][\"recipe\"][\"horizon\"] == h:\n            return p, m\n    raise RuntimeError((kind, h))\n\n\ndef save_json(p, obj):\n    tmp = p.with_suffix(\".tmp\")\n    tmp.write_text(json.dumps(obj, indent=2, ensure_ascii=False, allow_nan=False)+\"\\n\")\n    tmp.replace(p)\n\n\ndef quotes(index, cal, h, inventory, close_cache):\n    ids = cal.get_indexer(index.get_level_values(\"datetime\"))\n    assert (ids>=0).all()\n    inst = index.get_level_values(\"instrument\")\n    values = np.full(len(index),np.nan,dtype=\"float32\")\n    for name, positions in pd.Series(np.arange(len(index)),index=inst).groupby(level=0,sort=False):\n        if name not in close_cache:\n            stock_file = PROVIDER/\"features\"/name.lower()/\"close.day.bin\"\n            fp(stock_file, inventory[str(stock_file.relative_to(ROOT))])\n            close_cache[name] = np.fromfile(stock_file,dtype=\"<f4\")\n        block = close_cache[name]\n        pos = positions.to_numpy()\n        loc = ids[pos]-int(block[0])\n        ok = (loc+2>=1)&(loc+h+2<len(block))\n        values[pos[ok]] = block[loc[ok]+h+2]/block[loc[ok]+2]-np.float32(1)\n    return pd.Series(values,index=index)\n\n\ndef build(h, dates, cal, style, prepared, current, inventory, grade):\n    label_manifest, lm = cache_manifest(\"labels\", h)\n    raw_manifest, rm = cache_manifest(\"raw-labels\", h)\n    rp = raw_manifest.parent / rm[\"blocks\"][\"all\"][\"path\"]\n    raw_fp = fp(rp, rm[\"blocks\"][\"all\"])\n    raw = pd.read_pickle(rp)\n    series_old = []\n    series_new = []\n    excluded_na = 0\n    block_fps = []\n    close_cache = {}\n    for block in current[\"horizons\"][str(h)][\"blocks\"]:\n        yy = str(block[\"year\"])\n        old_block = lm[\"blocks\"][yy]\n        op, npth = label_manifest.parent / old_block[\"path\"], ROOT / block[\"path\"]\n        old = pd.read_pickle(op)\n        if npth.is_file():\n            record = {\"frozen_nov3\":fp(npth,block)}\n            new = pd.read_pickle(npth)\n        else:\n            raw_rebuilt = quotes(old.index,cal,h,inventory,close_cache)\n            new = ((raw_rebuilt.groupby(level=\"datetime\").rank(pct=True)-.5)*3.46).rename(\"LABEL0\")\n            sig = cache_value_summary(new)\n            assert sig==block[\"signature\"],(yy,sig,block[\"signature\"])\n            record = {\"missing_archived_raw_rank_block\":block[\"path\"],\"recovered_exact_signature\":sig}\n        block_fps.append({\"legacy\":fp(op, old_block),**record})\n        selected = old.index.get_level_values(\"datetime\").isin(dates)\n        assert old.index.equals(new.index) and old.isna().equals(new.isna())\n        old, new = old.loc[selected], new.loc[selected]\n        old_raw = raw.reindex(old.index)\n        assert old_raw.isna().equals(old.isna())\n        reconstructed = (old_raw.groupby(level=\"datetime\").rank(pct=True)-.5)*3.46\n        assert np.array_equal(old.to_numpy(), reconstructed.to_numpy(), equal_nan=True)\n        excluded_na += int(old.isna().sum())\n        series_old.append(old.dropna())\n        series_new.append(new.dropna())\n    old, new = pd.concat(series_old), pd.concat(series_new)\n    old_raw = raw.reindex(old.index)\n    del raw, series_old, series_new\n    gc.collect()\n    # Direct paired close lookup on the 2026-11-03 snapshot, including the raw old/new differences.\n    # Read only audited files relevant to the retained training cross-sections.\n    ids = cal.get_indexer(old.index.get_level_values(\"datetime\"))\n    direct = quotes(old.index,cal,h,inventory,close_cache)\n    quote_result = direct.to_numpy()\n    checked_stock_files = len(close_cache)\n    assert np.isfinite(quote_result).all()\n    updated_rank = (direct.groupby(level=\"datetime\").rank(pct=True)-.5)*3.46\n    assert np.array_equal(updated_rank.to_numpy(), new.to_numpy())\n    old_g, new_g = grade(old, \"quantile10\"), grade(new, \"quantile10\")\n    ready = style.ready_date.reindex(old.index.get_level_values(\"datetime\"))\n    assert ready.notna().all()\n    usable = ready.le(BOUNDARY).to_numpy() & (cal[ids+h+1]<=BOUNDARY)\n    fit_calibration = np.ones(len(old), dtype=bool) if h==20 else usable\n    c = new.loc[fit_calibration].astype(\"float32\").astype(\"float64\")\n    g = new_g.loc[fit_calibration]\n    mu, sd = float(c.mean()), float(c.std(ddof=0))\n    gmu, gsd = float(g.mean()), float(g.std(ddof=0))\n    scale = sd/gsd\n    offset = mu-scale*gmu\n    target = (old_g.astype(\"float64\")*scale+offset).astype(\"float32\").rename(\"LABEL0\")\n    rows_by_grade = old_g.value_counts().sort_index()\n    kept = old_g.loc[usable].value_counts().sort_index()\n    dates_after = old.index.get_level_values(\"datetime\")[usable]\n    assert all(np.diff((np.arange(10)*scale+offset).astype(\"float32\"))>0)\n    report = {\"horizon\":h,\"training_dates\":int(old.index.get_level_values(\"datetime\").nunique()),\n              \"raw_formula\":f\"close[t+{h+1}]/close[t+1]-1\", \"rows\":len(old),\n              \"own_horizon_invalid_after_legacy_base_on_training_dates\":excluded_na,\n              \"old_rank_replay_from_raw_all_blocks_exact\":True,\"new_rank_replay_from_frozen_close_all_rows_exact\":True,\n              \"raw_old_vs_nov3_changed_exact\":int((old_raw.to_numpy()!=quote_result).sum()),\n              \"old_rank_vs_nov3_changed_float32\":int((old.to_numpy(dtype=\"float32\")!=new.to_numpy(dtype=\"float32\")).sum()),\n              \"old_vs_nov3_grade_changed\":int(old_g.ne(new_g).sum()),\n              \"canonical_target_mean\":mu,\"canonical_target_std\":sd,\"scale\":scale,\"offset\":offset,\n              \"scores_float32\":list(map(float,(np.arange(10)*scale+offset).astype(\"float32\"))),\n              \"affine_calibration_rows\":len(g),\"legacy_bin_counts_all\":list(map(int,rows_by_grade)),\n              \"legacy_bin_counts_mature\":list(map(int,kept)),\"cutoff_rows\":int(usable.sum()),\"cutoff_dates\":int(dates_after.nunique()),\n              \"cutoff_last_signal\":str(dates_after.max().date()),\"verified_nov3_close_files\":checked_stock_files,\n              \"frozen_weekly_h5_membership\":fp(WEEK),\"old_csrank_manifest\":fp(label_manifest),\n              \"old_raw_manifest\":fp(raw_manifest),\"raw_old\":raw_fp,\"source_blocks\":block_fps}\n    if h==20:\n        refrec = prepared[\"variants\"][\"quantile10\"][\"old\"]\n        ref = pd.read_pickle(ROOT/refrec[\"path\"])\n        assert ref.equals(target) and np.array_equal(target.to_numpy(), ref.to_numpy())\n        assert (scale,offset)==(prepared[\"variants\"][\"quantile10\"][\"scale\"],prepared[\"variants\"][\"quantile10\"][\"offset\"])\n        report.update(v5_original=fp(ROOT/refrec[\"path\"],refrec),all_v5_rows_replayed_exact=True)\n    return target,report\n\n\ndef main():\n    for d in (\"docs\",\"data\"):\n        (OUT/d).mkdir(parents=True, exist_ok=True)\n    prepared = load(GRADING/\"configs/prepared-inputs.json\")\n    current = load(UPDATED/\"docs/prepared-labels.json\")\n    source = load(GRADING/\"docs/adapter-common.json\")[\"source_text\"]\n    ns = {}\n    exec(source[source.index(\"def grade(\"):],ns)\n    dates = pd.DatetimeIndex(pd.to_datetime(pd.read_csv(DATES,comment=\"#\").date))\n    cal = pd.DatetimeIndex(pd.to_datetime((PROVIDER/\"calendars/day.txt\").read_text().splitlines()))\n    style = pd.read_csv(WEEK,parse_dates=[\"datetime\",\"ready_date\"]).set_index(\"datetime\")\n    inventory_source = GRADING/\"docs/provider-inputs.json.gz\"\n    with gzip.open(inventory_source,\"rt\") as f:\n        inv = json.load(f)\n    inv = {str(Path(x[\"path\"]).relative_to(ROOT)) if Path(x[\"path\"]).is_absolute() else x[\"path\"]:x for x in inv[\"files\"]}\n    t20, r20 = build(20, dates, cal, style, prepared, current, inv, ns[\"grade\"])\n    print(\"v5 H20 exact\",r20[\"rows\"],flush=True)\n    t5, r5 = build(5, dates, cal, style, prepared, current, inv, ns[\"grade\"])\n    plus = int((~t5.index.isin(t20.index)).sum())\n    minus = int((~t20.index.isin(t5.index)).sum())\n    out = OUT/\"data/h5-quantile10.pkl\"\n    tmp = out.with_suffix(\".partial\");t5.to_pickle(tmp);tmp.replace(out)\n    assert pd.read_pickle(out).equals(t5)\n    doc = {\"target\":fp(out),\"horizon\":5,\"formula\":\"Ref($close,-6)/Ref($close,-1)-1\",\n           \"generation\":\"Raw return from t+1 close through t+6 close. On the frozen feature/listing/H40 legacy row universe, discard a stock only on its own H5 missing return, then compute equal-date cross-sectional average-tie percentile and CSRankNorm (p−0.5)×3.46. Derive exact doubled midranks, grade in ten right-closed bins with legacy old rank labels. Grade values use one positive affine transform calibrated on contemporary Nov3 H5 labels restricted to the full eligible pre-cutoff training union: match the reference continuous mean and population SD; no daily demeaning/reranking after grading and no style-specific calibration.\",\n           \"resolved_sources\":\"Legacy source is Nov2 prepared features, H40/listing base, old alternate H5 CSRankNorm and H5 raw cache. The refreshed Nov3 frozen raw H5 quotepanel is used only to reconcile rank labels and calibrate the affine encoding as in the v5 paired recipe. In the v5 regression the complete original H20 rows are used for that historical affine fit.\",\n           \"H5_not_in_H20\":plus,\"H20_not_in_H5\":minus,\"h5\":r5,\"h20_reproduction\":r20,\n           \"train_dates\":fp(DATES),\"day_weights\":fp(WEIGHTS),\"provider_calendar\":fp(PROVIDER/\"calendars/day.txt\"),\n           \"provider_inventory\":fp(inventory_source,prepared[\"provider_inventory\"]),\n           \"feature_manifest\":fp(ROOT/prepared[\"source_manifests\"][0][\"path\"],prepared[\"source_manifests\"][0]),\n           \"archived_v5_recipe\":fp(GRADING/\"docs/adapter-prepare.json\"),\"old_grade_function\":fp(GRADING/\"docs/adapter-common.json\"),\n           \"horizon_preparation\":fp(UPDATED/\"docs/prepared-labels.json\"),\"source_code\":Path(__file__).read_text(),\n           \"new_fits\":0}\n    save_json(OUT/\"docs/h5-target.json\",doc)\n    print(\"H5 ready\",len(t5),r5[\"cutoff_rows\"],plus,minus,doc[\"target\"],flush=True)\n\n\nif __name__==\"__main__\":\n    main()\n",
  "new_fits": 0
}
