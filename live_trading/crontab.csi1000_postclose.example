# Install only after the active-config contract in README.md is confirmed.
# Secrets/account IDs belong in ~/.qlib_live_env, never in this file.

SHELL=/bin/bash
PATH=/opt/anaconda3/envs/qlib/bin:/usr/local/bin:/usr/bin:/bin

# One 23:00 trigger runs postclose -> publish -> evening serially and records
# one atomic attempt receipt per stage. Failed stages remain manual recovery.
0 23 * * 1-5 /Users/yuxianqi/Project/qlib/live_trading/run_scheduler_cron.sh alla_v4_ladder_k1h5_postclose_real
